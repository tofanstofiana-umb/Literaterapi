# Salin berkas ini menjadi .env.local dan isi dengan nilai proyek Supabase
# Anda (Project Settings â†’ API). JANGAN PERNAH commit .env.local ke git.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Hanya dipakai di Edge Functions/skrip server (mis. seeding, admin task),
# TIDAK PERNAH dikirim ke browser â€” lihat PRD bagian 18 "service role tidak
# pernah dikirim ke browser". Jangan tambahkan prefix NEXT_PUBLIC_ di sini.
SUPABASE_SERVICE_ROLE_KEY=

# Terjemahan otomatis konten cerita. Pilih salah satu:
# 1) OpenAI Responses API
OPENAI_API_KEY=
OPENAI_TRANSLATION_MODEL=gpt-4o-mini
